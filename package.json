{
  "name": "pi-ansicat",
  "version": "0.2.2",
  "description": "Paste images with ANSI preview + vision fallback for text-only models",
  "keywords": [
    "pi-package",
    "pi-extension",
    "clipboard",
    "image",
    "preview",
    "ansi",
    "foot",
    "vision"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shironxn/pi-ansicat.git"
  },
  "bugs": {
    "url": "https://github.com/shironxn/pi-ansicat/issues"
  },
  "author": "shironxn <97370421+shironxn@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/shironxn/pi-ansicat#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0"
  },
  "files": [
    "src",
    "index.ts",
    "assets",
    "CHANGELOG.md"
  ],
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "./assets/preview.png"
  }
}
