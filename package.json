{
  "name": "pi-ansicat",
  "version": "0.1.0",
  "description": "Paste images with ANSI preview + vision fallback for text-only models",
  "keywords": [
    "pi-package",
    "pi-extension",
    "clipboard",
    "image",
    "preview",
    "ansi",
    "foot",
    "vision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shironxn/pi-ansicat"
  },
  "bugs": {
    "url": "https://github.com/shironxn/pi-ansicat/issues"
  },
  "author": "shironxn <97370421+shironxn@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/shironxn/pi-ansicat#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-tui": ">=0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.0.0",
    "markdownlint-cli": "^0.49.1",
    "typescript": "^6.0.0"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint:md": "markdownlint --config .markdownlint.json README.md"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
