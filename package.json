{
  "name": "pi-ansicat",
  "version": "0.5.0",
  "description": "Paste clipboard images into the pi coding agent with a truecolor ANSI preview and a vision fallback for text-only models",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "clipboard",
    "image",
    "preview",
    "ansi",
    "truecolor",
    "terminal",
    "wayland",
    "x11",
    "vision",
    "foot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shironxn/pi-ansicat.git"
  },
  "bugs": {
    "url": "https://github.com/shironxn/pi-ansicat/issues"
  },
  "author": "shironxn <97370421+shironxn@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/shironxn/pi-ansicat#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^6.0.0"
  },
  "files": [
    "src",
    "index.ts",
    "assets",
    "CHANGELOG.md"
  ],
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test",
    "eval": "bash eval/run.sh"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/shironxn/pi-ansicat/main/assets/preview.png"
  }
}
